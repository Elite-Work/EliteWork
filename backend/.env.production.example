# Production environment example — copy values into the production secret store.
# Validated in CI against the runtime env schema; see scripts/validate-env-examples.mjs
#
# NOTE: NODE_ENV=production REQUIRES a tracing backend (JAEGER_ENDPOINT,
# ZIPKIN_ENDPOINT, or an OTEL exporter). Boot fails fast if none is configured
# to avoid silent observability loss during incidents.
PORT=4000
TRUST_PROXY=true
NODE_ENV=production
DATABASE_URL=postgresql://user:password@prod-db:5432/amana
SUPABASE_URL=https://prod.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=production-jwt-secret-must-be-at-least-32-characters-long-change-me
JWT_EXPIRES_IN=86400
JWT_ISSUER=amana
JWT_AUDIENCE=amana-api
REDIS_URL=redis://:password@prod-redis:6379/0
CORS_ORIGINS=https://app.amana.com
API_PUBLIC_URL=https://api.amana.com

# Stellar / Soroban (mainnet for production)
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://soroban-rpc.mainnet.stellar.org
AMANA_ESCROW_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_CONTRACT_ID=CYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
ADMIN_STELLAR_PUBKEYS=
ADMIN_SECRET_KEY=
ADMIN_ROUTES_ENABLED=true
ADMIN_ROUTE_TIMEOUT_MS=15000

# Cooperative pilot (issues #43/#44): "coop-id:wallet,coop-id:wallet" pairs.
COOPERATIVE_ADMINS=
COOPERATIVE_MEMBERS=

# Pinata / IPFS
PINATA_API_KEY=
PINATA_SECRET=
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
IPFS_URL_SIGNING_SECRET=
IPFS_URL_TTL_SECONDS=300

# Evidence / manifest
EVIDENCE_MAX_BYTES=52428800
EVIDENCE_METADATA_RETENTION_DAYS=90
EVIDENCE_SCAN_REQUIRED=true
MANIFEST_PII_RETENTION_DAYS=30

# Soroban event listener
EVENT_POLL_INTERVAL_MS=10000
BACKOFF_INITIAL_MS=1000
BACKOFF_MAX_MS=30000
PROCESSED_LEDGERS_CACHE_SIZE=10000
EVENT_OUTBOX_MAX_ATTEMPTS=5

# Distributed tracing (REQUIRED in production — boot fails fast without it)
JAEGER_ENDPOINT=http://jaeger-collector.monitoring:14268/api/traces
ZIPKIN_ENDPOINT=
PROMETHEUS_PORT=9464
OTEL_SERVICE_NAME=amana-backend
OTEL_EXPORTER_JAEGER_AGENT_HOST=
OTEL_EXPORTER_JAEGER_AGENT_PORT=

# Tail-based trace sampling (production: low baseline to bound storage cost)
TRACE_BASELINE_RATE=0.05
TRACE_SLOW_THRESHOLD_MS=2000
TRACE_ROUTE_OVERRIDES={}

# Audit export signing
AUDIT_SIGNING_KEY_ID=amana-audit-key-v1
AUDIT_SIGNING_PRIVATE_KEY_PEM=
AUDIT_SIGNING_PUBLIC_KEY_PEM=

# Webhooks (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# Ops alert webhook
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_COOLDOWN_MS=300000

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_REFRESH_WINDOW_MS=900000
RATE_LIMIT_AUTH_REFRESH_MAX=30
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=30
RATE_LIMIT_DISPUTE_WINDOW_MS=3600000
RATE_LIMIT_DISPUTE_MAX=5

# Admin operation quotas
ADMIN_QUOTA_CLAWBACK_WINDOW_MS=3600000
ADMIN_QUOTA_CLAWBACK_MAX=10
ADMIN_QUOTA_TRADE_BATCH_WINDOW_MS=3600000
ADMIN_QUOTA_TRADE_BATCH_MAX=20

# Admin Soroban submission retry/backoff
SOROBAN_SUBMIT_MAX_RETRIES=3
SOROBAN_SUBMIT_BACKOFF_MS=1000,2000,4000,8000

# Reconciliation / PII cron
RECONCILIATION_CRON_ENABLED=true
PII_SCANNER_CRON_ENABLED=true
PII_SCANNER_SAMPLE_SIZE=2000
