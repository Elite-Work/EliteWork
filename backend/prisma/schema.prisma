generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pooling is configured via the DATABASE_URL connection string
  // Example with PgBouncer: postgresql://user:password@localhost:5432/amana?pgbouncer=true
  // For production, ensure the connection pool size is appropriate for your workload:
  // - connection_limit: typically 20-100 connections
  // - pool_mode: use 'transaction' or 'session' mode based on your needs
}

enum TradeStatus {
  PENDING_SIGNATURE
  CREATED
  FUNDED
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED
  EXPIRED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Lifecycle of a vested token stream.
/// ACTIVE/SUSPENDED are live states an admin may terminate from; TERMINATED and
/// COMPLETED are terminal, so a second termination is rejected rather than replayed.
enum StreamStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
  COMPLETED
}

/// Lifecycle of a payout intent. The order matters: an intent only ever moves
/// forward, and CONFIRMED is terminal for the purposes of deduplication.
enum PayoutIntentStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

/// Which fund-moving contract call an intent covers.
enum PayoutKind {
  RELEASE
  MILESTONE_RELEASE
  REFUND
  CLAWBACK
}

enum ChainEventSyncStatus {
  PENDING
  RETRYING
  PROCESSED
  DEAD_LETTER
}

/// User model representing a participant in the Amana platform
/// - walletAddress: Stellar wallet address (stored as lowercase for consistency)
/// - displayName: User's display name
/// - createdAt: Timestamp of account creation
model User {
  id              Int              @id @default(autoincrement())
  /// Unique wallet address (always stored as lowercase)
  walletAddress   String           @unique @db.VarChar(255)
  displayName     String           @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  tradesBought    Trade[]          @relation("buyer")
  tradesSold      Trade[]          @relation("seller")
  initiatedDisputes Dispute[]      @relation("initiator")
  vaults          Vault[]
  goals           Goal[]
  tradeTemplates  TradeTemplate[]
  watchlist       UserWatchlist[]
  refreshTokens   RefreshToken[]
  wallets         UserWallet[]
  webhooks        Webhook[]
  webhookSubscriptions WebhookSubscription[]
  notifications   InAppNotification[]
  notificationPreference NotificationPreference?

  @@index([walletAddress])
}

/// Trade model representing a transaction on the Amana platform
/// - tradeId: Unique identifier for the trade (from blockchain)
/// - buyerAddress: Wallet address of the buyer (stored as lowercase)
/// - sellerAddress: Wallet address of the seller (stored as lowercase)
/// - amountUsdc: Amount in USDC (stored as string to preserve precision)
/// - status: Current status of the trade
model Trade {
  id            Int         @id @default(autoincrement())
  tradeId       String      @unique @db.VarChar(255)
  buyerAddress  String      @db.VarChar(255)
  sellerAddress String      @db.VarChar(255)
  amountUsdc    String      @default("0") @db.VarChar(100)
  buyerLossBps  Int         @default(5000)
  sellerLossBps Int         @default(5000)
  /// Monotonic optimistic concurrency counter for status transitions.
  version       Int         @default(0)
  status        TradeStatus @default(CREATED)
  /// Canonical timestamp set once when the trade transitions to FUNDED.
  fundedAt      DateTime?
  /// Canonical timestamp set once when the trade transitions to DELIVERED.
  deliveredAt   DateTime?
  /// Canonical timestamp set once when the trade transitions to COMPLETED.
  completedAt   DateTime?
  /// Optional deadline after which the sweeper may drive the trade to CANCELLED and trigger a refund.
  expiresAt     DateTime?
  /// Set by the sweeper once a refund has been successfully submitted on-chain.
  expiredAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  buyer         User             @relation("buyer", fields: [buyerAddress], references: [walletAddress])
  seller        User             @relation("seller", fields: [sellerAddress], references: [walletAddress])
  dispute       Dispute?
  manifest      DeliveryManifest?
  evidence      TradeEvidence[]
  notes           TradeNote[]
  watchlistEntries UserWatchlist[]
  releaseMilestones EscrowReleaseMilestone[]

  @@index([tradeId])
  @@index([buyerAddress])
  @@index([sellerAddress])
  @@index([status])
  @@index([buyerAddress, status, createdAt])
  @@index([sellerAddress, status, createdAt])
}

/// TradeTemplate stores a user's reusable trade terms. The buyer is always the
/// authenticated user at creation time, so it is intentionally not persisted.
model TradeTemplate {
  id              Int      @id @default(autoincrement())
  userAddress     String   @db.VarChar(255)
  name            String   @db.VarChar(100)
  sellerAddress   String   @db.VarChar(255)
  amountUsdc      String   @db.VarChar(100)
  buyerLossBps    Int      @default(5000)
  sellerLossBps   Int      @default(5000)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userAddress], references: [walletAddress], onDelete: Cascade)

  @@unique([userAddress, name])
  @@index([userAddress, createdAt])
}

/// UserWatchlist is a user-scoped bookmark. The composite unique constraint
/// makes adding the same trade idempotent and prevents duplicate favorites.
model UserWatchlist {
  id          Int      @id @default(autoincrement())
  userAddress String   @db.VarChar(255)
  tradeId     String   @db.VarChar(255)
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userAddress], references: [walletAddress], onDelete: Cascade)
  trade Trade @relation(fields: [tradeId], references: [tradeId], onDelete: Cascade)

  @@unique([userAddress, tradeId])
  @@index([userAddress, createdAt])
  @@index([tradeId])
}

/// DisputeCategory model for classifying disputes
/// - name: Human-readable category name (unique)
/// - description: Optional description of the category
model DisputeCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  disputes    Dispute[]

  @@index([name])
  @@index([isActive])
}

/// Dispute model representing a dispute on a trade
/// - tradeId: Reference to the associated trade
/// - initiator: Wallet address of the user initiating the dispute (stored as lowercase)
/// - reason: Reason for the dispute
/// - status: Current status of the dispute
/// - resolvedAt: Timestamp when the dispute was resolved
/// - categoryId: Optional reference to a DisputeCategory
model Dispute {
  id           Int              @id @default(autoincrement())
  tradeId      String           @unique @db.VarChar(255)
  initiator    String           @db.VarChar(255)
  reason       String           @db.Text
  status       DisputeStatus    @default(OPEN)
  /// Monotonic optimistic concurrency counter for status transitions.
  version      Int              @default(0)
  resolvedAt   DateTime?
  categoryId   Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  trade        Trade            @relation(fields: [tradeId], references: [tradeId], onDelete: Cascade)
  initiatorUser User            @relation("initiator", fields: [initiator], references: [walletAddress])
  category     DisputeCategory? @relation(fields: [categoryId], references: [id])

  @@index([tradeId])
  @@index([initiator])
  @@index([status])
  @@index([categoryId])
}

/// DeliveryManifest — submitted by the seller before shipping.
/// Sensitive fields (driverName, driverIdNumber) are hashed with SHA-256 before
/// being sent on-chain; raw values are stored here for mediator review.
model DeliveryManifest {
  id                      Int      @id @default(autoincrement())
  tradeId                 String   @unique @db.VarChar(255)
  /// Raw (plaintext) driver name — mediator-only access
  driverName              String   @db.VarChar(255)
  /// Raw driver ID number
  driverIdNumber          String   @db.VarChar(255)
  vehicleRegistration     String   @db.VarChar(100)
  routeDescription        String   @db.Text
  expectedDeliveryAt      DateTime
  /// SHA-256 hash of driverName — stored on-chain
  driverNameHash          String   @db.VarChar(64)
  /// SHA-256 hash of driverIdNumber — stored on-chain
  driverIdHash            String   @db.VarChar(64)
  createdAt               DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [tradeId], onDelete: Cascade)

  @@index([tradeId])
}

/// TradeEvidence — IPFS-pinned files submitted as delivery evidence
model TradeEvidence {
  id          Int      @id @default(autoincrement())
  tradeId     String   @db.VarChar(255)
  cid         String   @db.VarChar(255)
  filename    String   @db.VarChar(255)
  mimeType    String   @db.VarChar(100)
  uploadedBy  String   @db.VarChar(255)
  createdAt   DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [tradeId], onDelete: Cascade)

  @@index([tradeId])
  @@index([tradeId, createdAt])
  @@index([cid])
}

/// ProcessedEvent model for exactly-once event processing deduplication
/// - ledgerSequence: The sequence number of the ledger containing the event
/// - contractId: The contract that emitted the event
/// - eventId: The unique on-chain event ID
/// - processedAt: Timestamp of when the event was processed
model ProcessedEvent {
  id              Int      @id @default(autoincrement())
  ledgerSequence  Int
  contractId      String   @db.VarChar(255)
  eventId         String   @db.VarChar(255)
  processedAt     DateTime @default(now())

  @@unique([ledgerSequence, contractId, eventId])
  @@index([ledgerSequence])
}

/// ChainEventOutbox model for durable event processing state and retries
model ChainEventOutbox {
  id              Int                  @id @default(autoincrement())
  ledgerSequence  Int
  contractId      String               @db.VarChar(255)
  eventId         String               @db.VarChar(255)
  eventType       String               @db.VarChar(100)
  tradeId         String               @db.VarChar(255)
  payload         Json
  status          ChainEventSyncStatus @default(PENDING)
  attempts        Int                  @default(0)
  nextAttemptAt   DateTime             @default(now())
  lastError       String?              @db.Text
  deadLetteredAt  DateTime?
  processedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([ledgerSequence, contractId, eventId])
  @@index([status, nextAttemptAt])
  @@index([ledgerSequence])
}

/// Vault model representing a savings vault on Soroban
/// - vaultId: Unique identifier from blockchain
/// - ownerAddress: Wallet address of vault owner (lowercase)
/// - balanceUsdc: Current balance in USDC (string for precision)
/// - createdAt: Timestamp of vault creation
model Vault {
  id              Int      @id @default(autoincrement())
  vaultId         String   @unique @db.VarChar(255)
  ownerAddress    String   @db.VarChar(255)
  balanceUsdc     String   @default("0") @db.VarChar(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  owner           User     @relation(fields: [ownerAddress], references: [walletAddress])
  goals           Goal[]

  @@index([vaultId])
  @@index([ownerAddress])
}

/// Goal model representing a savings goal linked to a vault
/// - goalId: Unique identifier from blockchain
/// - vaultId: Reference to parent vault
/// - targetAmountUsdc: Target amount to save (string for precision)
/// - currentAmountUsdc: Current accumulated amount (string for precision)
/// - deadline: Target completion date
/// - status: Goal status (ACTIVE, COMPLETED, CANCELLED)
/// - createdAt: Timestamp of goal creation
model Goal {
  id                  Int         @id @default(autoincrement())
  goalId              String      @unique @db.VarChar(255)
  vaultId             String      @db.VarChar(255)
  userId              Int
  targetAmountUsdc    String      @db.VarChar(100)
  currentAmountUsdc   String      @default("0") @db.VarChar(100)
  deadline            DateTime
  status              GoalStatus  @default(ACTIVE)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relations
  vault               Vault       @relation(fields: [vaultId], references: [vaultId], onDelete: Cascade)
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([vaultId])
  @@index([userId])
  @@index([status])
}

/// RefreshToken model for tracking active sessions and preventing reuse
model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(255)
  jti       String   @unique @db.VarChar(255)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([jti])
}

model UserWallet {
  id            Int      @id @default(autoincrement())
  userId        Int
  walletAddress String   @db.VarChar(255)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, walletAddress])
  @@index([userId])
  @@index([walletAddress])
}

/// Webhook model representing a registered webhook endpoint owned by a user
/// - url: The target URL to which webhook payloads are delivered
/// - description: Optional human-readable label
/// - isActive: Whether the webhook is currently accepting deliveries
model Webhook {
  id          Int      @id @default(autoincrement())
  userAddress String   @db.VarChar(255)
  url         String   @db.VarChar(2048)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user             User                    @relation(fields: [userAddress], references: [walletAddress], onDelete: Cascade)
  deliveryAttempts WebhookDeliveryAttempt[]

  @@index([userAddress, createdAt])
}

/// WebhookDeliveryAttempt records a single delivery attempt for a webhook
/// - timestamp: When the delivery was attempted
/// - status: Outcome of the delivery (e.g. "success", "failure")
/// - statusCode: HTTP status code returned by the target
/// - responseBody: Response body from the target (if any)
model WebhookDeliveryAttempt {
  id           Int      @id @default(autoincrement())
  webhookId    Int
  timestamp    DateTime @default(now())
  status       String   @db.VarChar(50)
  statusCode   Int
  responseBody String?  @db.Text

  // Relations
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, timestamp])
}

/// WebhookSubscription stores event subscription endpoints owned by a user.
model WebhookSubscription {
  id          Int      @id @default(autoincrement())
  url         String   @db.VarChar(500)
  events      String[]
  secretHash  String   @db.VarChar(64)
  isActive    Boolean  @default(true)
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

/// InAppNotification represents an in-app notification for a user
/// - type: Category of notification (e.g. "trade_update", "dispute", "system")
/// - isRead: Whether the notification has been read
/// - metadata: Optional JSON payload with additional context
model InAppNotification {
  id          Int      @id @default(autoincrement())
  userAddress String   @db.VarChar(255)
  title       String   @db.VarChar(255)
  message     String   @db.Text
  type        String   @db.VarChar(50)
  isRead      Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user        User     @relation(fields: [userAddress], references: [walletAddress], onDelete: Cascade)

  @@index([userAddress, isRead, createdAt])
}

/// NotificationPreference stores a user's trade notification channel choices.
/// The JSON payload is keyed by event type, with values like ["email", "push"].
model NotificationPreference {
  id          Int      @id @default(autoincrement())
  userAddress String   @unique @db.VarChar(255)
  preferences Json
  /// E.164 phone number for the "sms" notification channel, e.g. "+2348012345678".
  phoneNumber String?  @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userAddress], references: [walletAddress], onDelete: Cascade)

  @@index([userAddress])
}

/// TradeNote — private encrypted notes attached to a trade by a buyer or seller.
/// Each note is encrypted at rest with AES-256-GCM. Only the author can decrypt
/// their own notes. Notes are limited to 2000 characters of plaintext.
model TradeNote {
  id          Int      @id @default(autoincrement())
  tradeId     String   @db.VarChar(255)
  authorAddress String @db.VarChar(255)
  /// AES-256-GCM encrypted note content (base64-encoded iv + ciphertext + tag)
  content     String   @db.Text
  createdAt   DateTime @default(now())

  trade Trade @relation(fields: [tradeId], references: [tradeId], onDelete: Cascade)

  @@index([tradeId, authorAddress, createdAt])
  @@index([tradeId, createdAt])
  @@index([authorAddress])
}

/// AdminActionAudit — compliance record of admin-initiated actions (e.g. treasury
/// withdrawals/clawbacks) with an optional operator-supplied reason/note.
model AdminActionAudit {
  id              Int      @id @default(autoincrement())
  action          String   @db.VarChar(64)
  actorAddress    String   @db.VarChar(255)
  targetReference String?  @db.VarChar(255)
  note            String?  @db.Text
  createdAt       DateTime @default(now())
  /// SHA-256 hash of the previous entry's `hash` (empty string for the first entry).
  prevHash        String   @default("") @db.VarChar(64)
  /// SHA-256 hash of this entry's fields chained to prevHash — see auditChain.ts.
  hash            String   @default("") @db.VarChar(64)

  @@index([action, createdAt])
  @@index([actorAddress])
  @@index([createdAt])
}

/// EscrowReleaseMilestone represents one pre-defined partial release point.
/// releasedAt is set after the matching on-chain release event is confirmed.
model EscrowReleaseMilestone {
  id             Int       @id @default(autoincrement())
  tradeId        String    @db.VarChar(255)
  milestoneIndex Int
  amountUsdc     String    @db.VarChar(100)
  dueAt          DateTime
  conditionHash  String?   @db.VarChar(255)
  releasedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  trade          Trade     @relation(fields: [tradeId], references: [tradeId], onDelete: Cascade)

  @@unique([tradeId, milestoneIndex])
  @@index([tradeId, dueAt])
  @@index([tradeId, releasedAt])
}

/// PayoutIntent records the intent to move escrowed funds *before* the
/// transaction is built, so a retry can be recognised as the same payout.
///
/// Release and refund submissions can succeed on-chain and then fail before the
/// DB commit; without a durable intent, the retry looks like a fresh request and
/// pays out twice. The `idempotencyKey` unique constraint is the enforcement
/// point — a duplicate insert fails at the database, not in application logic
/// that a crash could skip.
///
/// - idempotencyKey: caller-supplied, or derived from (kind, tradeId, milestone)
/// - txHash: Soroban transaction hash, recorded on first successful submission
/// - duplicateAttempts: how many retries were short-circuited, for the metric
model PayoutIntent {
  id                Int                @id @default(autoincrement())
  idempotencyKey    String             @unique @db.VarChar(255)
  kind              PayoutKind
  tradeId           String             @db.VarChar(255)
  milestoneIndex    Int?
  amountUsdc        String             @db.VarChar(100)
  destination       String             @db.VarChar(255)
  requestedBy       String             @db.VarChar(255)
  status            PayoutIntentStatus @default(PENDING)
  txHash            String?            @db.VarChar(255)
  duplicateAttempts Int                @default(0)
  lastError         String?            @db.Text
  submittedAt       DateTime?
  confirmedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([tradeId, kind])
  @@index([status, updatedAt])
  @@index([txHash])
}

/// Stream model representing a vested token stream
model Stream {
  id              Int          @id @default(autoincrement())
  streamId        String       @unique @db.VarChar(255)
  recipient       String       @db.VarChar(255)
  totalVested     String       @db.VarChar(100)
  claimed         String       @default("0") @db.VarChar(100)
  unclaimed       String       @default("0") @db.VarChar(100)
  pendingClawback String       @default("0") @db.VarChar(100)
  /// Lifecycle state. Only ACTIVE and SUSPENDED streams can be terminated.
  status          StreamStatus @default(ACTIVE)
  /// Set when an admin terminates the stream; null while it is still live.
  terminatedAt      DateTime?
  terminatedBy      String?    @db.VarChar(255)
  terminationReason String?    @db.Text
  /// Free-form operator labels (e.g. "high-value", "legal-hold") so admins can
  /// group/filter streams in the admin stream list beyond lifecycle status.
  adminTags       String[]     @default([])
  /// Set when an admin locks the stream for maintenance; null when unlocked.
  lockedAt          DateTime?
  lockedBy          String?    @db.VarChar(255)
  lockReason        String?    @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  clawbackEvents  StreamClawbackEvent[]

  @@index([streamId])
  @@index([recipient])
  @@index([status])
}

/// StreamClawbackEvent records audit events of clawbacks performed by admins
model StreamClawbackEvent {
  id        Int      @id @default(autoincrement())
  streamId  String   @db.VarChar(255)
  admin     String   @db.VarChar(255)
  amount    String   @db.VarChar(100)
  timestamp DateTime
  txHash    String   @db.VarChar(255)
  createdAt DateTime @default(now())

  stream    Stream   @relation(fields: [streamId], references: [streamId], onDelete: Cascade)

  @@unique([streamId, txHash])
  @@index([streamId])
  @@index([admin])
}

/// OrphanDeposit tracks on-chain deposits that arrived without a matching Trade row.
/// The attach flow links an orphan to its intended trade and writes an audit entry.
model OrphanDeposit {
  id            Int       @id @default(autoincrement())
  /// The ledger sequence number of the deposit event.
  ledgerSeq     Int
  /// Transaction hash of the deposit.
  txHash        String    @unique @db.VarChar(255)
  /// Depositor wallet address detected from the chain event.
  depositorAddress String @db.VarChar(255)
  /// Amount in asset's stroops as reported by the contract event.
  amountRaw     String    @db.VarChar(100)
  /// Asset contract address (e.g. cNGN or USDC contract id).
  assetId       String    @db.VarChar(255)
  /// trade_id from the contract event, if emitted (may be null for truly orphaned deposits).
  contractTradeId String? @db.VarChar(255)
  /// Whether an admin has attached this orphan to a real Trade row.
  resolved      Boolean   @default(false)
  /// tradeId of the Trade this was eventually matched to, set by the attach flow.
  resolvedTradeId String? @db.VarChar(255)
  detectedAt    DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([resolved])
  @@index([depositorAddress])
  @@index([txHash])
}

/// ContractPauseLog tracks pause/unpause events for the guardian emergency stop.
model ContractPauseLog {
  id            Int      @id @default(autoincrement())
  paused        Boolean
  guardianAddress String @db.VarChar(255)
  reason        String?  @db.VarChar(500)
  txHash        String?  @db.VarChar(255)
  createdAt     DateTime @default(now())

  @@index([paused, createdAt])
  @@index([guardianAddress])
}

/// JobHeartbeat tracks the last successful execution time for scheduled jobs.
/// Used to detect missed heartbeats and trigger alerts when jobs silently fail.
model JobHeartbeat {
  id              Int      @id @default(autoincrement())
  /// Unique job identifier (e.g., "reconciliation", "trade-expiry", "webhook")
  jobType         String   @unique @db.VarChar(100)
  /// Timestamp of the last successful job execution
  lastHeartbeat   DateTime @default(now())
  /// Current job status: running|idle|failed
  status          String   @default("idle") @db.VarChar(50)
  /// Expected interval between job runs (milliseconds)
  intervalMs      Int      @default(86400000) // 24 hours default
  /// Next expected heartbeat time (lastHeartbeat + intervalMs)
  nextExpectedAt  DateTime
  /// Optional error message from last failed run
  lastError       String?  @db.Text
  /// Number of consecutive failures
  failureCount    Int      @default(0)
  /// Timestamp of the last check by the health watchdog
  lastCheckedAt   DateTime @default(now())
  /// User-provided notes/context about the job
  notes           String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([jobType])
  @@index([status, nextExpectedAt])
  @@index([lastCheckedAt])
}

/// EscrowAudit logs every escrow state transition for compliance and outbox completeness verification.
/// Records both the previous and new status so gap-detection can verify events were emitted.
model EscrowAudit {
  id              Int      @id @default(autoincrement())
  tradeId         String   @db.VarChar(255)
  eventType       String   @db.VarChar(100)
  fromStatus      String?  @db.VarChar(50)
  toStatus        String   @db.VarChar(50)
  actor           String?  @db.VarChar(255)
  contractId      String?  @db.VarChar(255)
  ledgerSequence  Int?
  extra           Json?
  createdAt       DateTime @default(now())

  @@index([tradeId])
  @@index([tradeId, createdAt])
  @@index([eventType])
}
